#!/bin/sh
# Last line of defence: audit every commit being pushed.
range=$(git rev-list @{u}..HEAD 2>/dev/null || git rev-list HEAD)
fail=0
for sha in $range; do
  if git log -1 --format='%B' "$sha" | grep -qiE 'co-authored-by.*(claude|anthropic)|generated with|🤖|\bclaude\b|\banthropic\b'; then
    echo "pre-push: $sha carries AI attribution" >&2
    fail=1
  fi
done
[ "$fail" = "1" ] && { echo "pre-push: refusing to push." >&2; exit 1; }
exit 0
